{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "identity-audit-logs-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/audit-logs/{**catch-all}"
        }
      },
      "identity-signatures-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/signatures/{**catch-all}"
        }
      },
      "equipment-catalog-route": {
        "ClusterId": "equipment-cluster",
        "Match": {
          "Path": "/api/Catalog/{**catch-all}"
        }
      },
      "equipment-device-route": {
        "ClusterId": "equipment-cluster",
        "Match": {
          "Path": "/api/Equipment/{**catch-all}"
        }
      },
      "equipment-type-route": {
        "ClusterId": "equipment-cluster",
        "Match": {
          "Path": "/api/EquipmentType/{**catch-all}"
        }
      },
      "equipment-storage-route": {
        "ClusterId": "equipment-cluster",
        "Match": {
          "Path": "/api/PhysicalStorage/{**catch-all}"
        }
      },
      "equipment-eav-form-templates-route": {
        "ClusterId": "equipment-cluster",
        "Match": {
          "Path": "/api/v1/eav-form-templates/{**catch-all}"
        }
      },
      "digitization-route": {
        "ClusterId": "digitization-cluster",
        "Match": {
          "Path": "/api/v1/digitization/{**catch-all}"
        }
      },
      "digitization-task-route": {
        "ClusterId": "digitization-cluster",
        "Match": {
          "Path": "/api/v1/digitization-task/{**catch-all}"
        }
      },
      "ocr-training-route": {
        "ClusterId": "digitization-cluster",
        "Match": {
          "Path": "/api/v1/ocr-training/{**catch-all}"
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/v1/Notifications/{**catch-all}"
        }
      },
      "report-route": {
        "ClusterId": "report-cluster",
        "Match": {
          "Path": "/api/v1/reports/{**catch-all}"
        }
      },
      "sync-route": {
        "ClusterId": "sync-cluster",
        "Match": {
          "Path": "/api/v1/sync/{**catch-all}"
        }
      },
      "workflow-route": {
        "ClusterId": "workflow-cluster",
        "Match": {
          "Path": "/api/v1/workflows/{**catch-all}"
        }
      },
      "workflow-def-route": {
        "ClusterId": "workflow-cluster",
        "Match": {
          "Path": "/api/WorkflowDefinitions/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5001"
          }
        }
      },
      "equipment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5002"
          }
        }
      },
      "digitization-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5003"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5004"
          }
        }
      },
      "report-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5006"
          }
        }
      },
      "sync-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5005"
          }
        }
      },
      "workflow-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5007"
          }
        }
      }
    }
  }
}
