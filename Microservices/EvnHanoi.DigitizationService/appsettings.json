{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Extraction": {
    "MaxTokens": 4096,
    "Temperature": 0.05,
    "MaxRetries": 2,
    "RetryDelayMs": 1000
  },
  "AIModelServers": {
    "OcrPageAttemptTimeoutSeconds": 60,
    "OcrPageTotalTimeoutSeconds": 180,
    "OcrPageCircuitBreakerSamplingMinutes": 10,
    "LlmAttemptTimeoutMinutes": 3,
    "LlmTotalTimeoutMinutes": 6,
    "LlmCircuitBreakerSamplingMinutes": 12
  }
}