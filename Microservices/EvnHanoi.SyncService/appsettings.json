{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Pmis": {
    "IncrementalSync": {
      "Enabled": false,
      "FullSweepIntervalHours": 168,
      "ParentRescanIntervalHours": 24,
      "EquipmentDetailCallsPerRun": 2000,
      "ParentScanTimeShare": 0.75,
      "HashVersion": 1
    },
    "DocumentFile": {
      "BatchSize": 50,
      "MaxParallel": 4,
      "InitialParallel": 2,
      "MaxBytes": 104857600,
      "SpoolThresholdBytes": 4194304,
      "TransientRetryMinutes": 10,
      "ExcludedCodePrefixes": ""
    },
    "DocumentSync": {
      "CountRecheckHours": 12,
      "DeltaSafetyMarginDays": 7,
      "FullRescanIntervalDays": 7,
      "MaxConsecutiveOwnerErrors": 15,
      "WindowThreshold": 50000,
      "WindowStartYear": 2000
    },
    "Schedule": {
      "MinFrequencyMinutes": 120,
      "RunBudgetBufferMinutes": 10
    }
  }
}