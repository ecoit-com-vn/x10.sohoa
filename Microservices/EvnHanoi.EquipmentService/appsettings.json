{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileUpload": {
    "MaxFileSizeBytes": 536870912,
    "ChunkSizeBytes": 10485760,
    "DirectUploadThresholdBytes": 10485760,
    "UploadSessionExpiryMinutes": 240
  },
  "FileDownload": {
    "OneTimeTokenTTLSeconds": 60
  },
  "Antivirus": {
    "ClamAvEnabled": "false",
    "ClamAvHost": "clamav-service",
    "ClamAvPort": 3310,
    "ScanTimeoutSeconds": 300
  },
  "MinIO": {
    "DocumentBucketName": "documents",
    "DossierBucketName": "dossiers",
    "UploadSessionsBucketName": "upload-sessions"
  }
}
